<?xml version="1.0"?>
<!-- Scenario 20: LTAP with parked-car occluders (occluded cell of the 2x2
     closed-loop matrix).  Same intersection as scenario_3.  Two cross-traffic
     vehicles approach from the east; five stationary cars along the eastern
     curb block the ego's diagonal sight-line until the cross-traffic emerges.
     The de-occluded twin is scenario_20_deoc.xml (no occluder cars).
-->
<scenarios>
    <scenario name="Scenario_20" type="Scenario_20" town="Town03">
        <ego_vehicle x="-84.8" y="70" z="1.0" yaw="90" model="vehicle.nissan.patrol" />

        <!-- Cross-traffic: two vehicles approaching from the east at speed -->
        <other_actor x="-20.0" y="127.7" z="-500" yaw="180" model="vehicle.lincoln.mkz_2017" />
        <other_actor x="-10.0" y="127.7" z="-500" yaw="180" model="vehicle.tesla.model3" />

        <!-- Stationary cars as occluders (regular vehicle classes within
             the Multi-V2X training distribution; matches scenario_3). -->
        <other_actor x="-81.0" y="119.7" z="-500" yaw="90" model="vehicle.audi.a2" />
        <other_actor x="-81.0" y="110.7" z="-500" yaw="90" model="vehicle.tesla.model3" />
        <other_actor x="-81.0" y="101.7" z="-500" yaw="90" model="vehicle.mercedes.coupe" />
        <other_actor x="-81.0" y="92.7" z="-500" yaw="90" model="vehicle.bmw.grandtourer" />
        <other_actor x="-81.0" y="83.7" z="-500" yaw="90" model="vehicle.nissan.patrol" />

        <weather cloudiness="0" precipitation="0" precipitation_deposits="0"
                 wind_intensity="0" sun_azimuth_angle="0" sun_altitude_angle="75"
                 fog_density="0" />
    </scenario>
</scenarios>
