<scenarios>
    <scenario name="Scenario_1" type="Scenario_1" town="Town01">
        <ego_vehicle x="317.4" y="195.4" z="0.3" yaw="180" model="vehicle.nissan.patrol" />
        <other_actor x="278.0" y="195.4" z="-500" yaw="180" model="vehicle.carlamotors.carlacola" />
        <!-- Single aggressive oncoming (y=199, eastbound). It is tracked
             upstream in locale_1 (rsu2 @ x=205), crosses the boundary near
             x=245, and accelerates through the conflict at x=278. It spends
             enough time upstream to build a memo-bank that shows the
             acceleration, so a full-latent (warm) migration predicts the true
             (fast) arrival and the ego waits; a box+velocity snapshot (kf)
             extrapolates constant velocity, under-predicts arrival, and the
             ego commits into a closing gap. The truck occludes the oncoming
             from rsu1 (locale_0), so locale_0 cannot re-acquire it in time,
             which is what makes the migrated state necessary. -->
        <other_actor x="210.0" y="199.0" z="-500" yaw="0" model="vehicle.nissan.seat.leon" />
        <weather cloudiness="0" precipitation="0" precipitation_deposits="0" wind_intensity="0" sun_azimuth_angle="0" sun_altitude_angle="75" />
    </scenario>
</scenarios>
