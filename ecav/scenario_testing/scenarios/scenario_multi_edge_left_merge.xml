<?xml version="1.0"?>
<scenarios>
    <!-- Scenario B: Town06 left-merge / obstacle hand-off.
         Ego (right lane) is forced to merge left around a stationary emergency
         vehicle; a fast NPC approaches from behind in the left lane and crosses
         the locale 0 -> locale 1 boundary, triggering an obstacle KF hand-off so
         locale 1 sees the NPC before its own RSU can. 'name' matches the YAML
         scenario field; 'type' matches the .py class name. -->
    <scenario name="Scenario_MultiEdgeLeftMerge" type="Scenario_MultiEdgeLeftMerge" town="Town06">
        <ego_vehicle x="100.0" y="139.5" z="1.0" yaw="0" model="vehicle.nissan.patrol" />
        <!-- other_actors[0] = emergency vehicle (stationary, blocks right lane).
             Underground (z=-500) until ActorTransformSetter teleports it up. -->
        <other_actor x="280.0" y="139.5" z="-500" yaw="0" model="vehicle.ford.ambulance" />
        <!-- other_actors[1] = fast NPC (left lane, 80 km/h east). Underground until teleported. -->
        <other_actor x="0.0" y="143.5" z="-500" yaw="0" model="vehicle.tesla.model3" />
        <weather cloudiness="10" precipitation="0" precipitation_deposits="0" wind_intensity="0" sun_azimuth_angle="0" sun_altitude_angle="75" fog_density="0" />
    </scenario>
</scenarios>
