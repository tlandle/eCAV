<?xml version="1.0"?>
<scenarios>
    <!-- Highway merge (cut-in) for the SenSys harness on Town06. The ego cruises east
         in lane -4 (y = 139.43 + 0.0041 x). other_actors[0] is the intruder (Tesla so the
         conflict-actor rule finds it), other_actors[1] the optional occluding truck; both
         spawn underground and the scenario places them from the design (closing speed,
         gap) when it teleports them up. 'name' matches the YAML scenario field, 'type' the
         .py class name. -->
    <scenario name="Scenario_HighwayMerge" type="Scenario_HighwayMerge" town="Town06">
        <ego_vehicle x="100.0" y="139.84" z="0.5" yaw="0.2" model="vehicle.nissan.patrol" />
        <other_actor x="200.0" y="143.75" z="-500" yaw="0.2" model="vehicle.tesla.model3" />
        <other_actor x="180.0" y="143.75" z="-500" yaw="0.2" model="vehicle.carlamotors.carlacola" />
        <weather cloudiness="10" precipitation="0" precipitation_deposits="0" wind_intensity="0" sun_azimuth_angle="0" sun_altitude_angle="75" fog_density="0" />
    </scenario>
</scenarios>
